PORT=5000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/carwash
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# --- Optional integrations (carwash-compile/06-platform/integrations.md) ---
# The app runs fully without these — membership billing/WhatsApp messaging just degrade to
# a local demo mode (no real charge, message logged as not_configured) until they're set.

# Stripe: membership billing. Get from https://dashboard.stripe.com/apikeys (use a test-mode
# "sk_test_..." key while developing). STRIPE_WEBHOOK_SECRET comes from the webhook endpoint
# you register in the Stripe dashboard for POST {API_URL}/api/webhooks/stripe (or from
# `stripe listen` locally) — required for webhook events (payment success/failure) to be
# processed at all; without it the endpoint responds 501.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# WhatsApp Business Platform Cloud API: customer messaging. Get WHATSAPP_TOKEN and
# WHATSAPP_PHONE_NUMBER_ID from https://developers.facebook.com/apps (WhatsApp product).
# Message templates (wash-ready, membership-welcome, payment-failed-update-card — see
# carwash-compile/04-growth/whatsapp.md) must be created and Meta-approved on that number
# first, or sends will fail with a clear error logged to customer_messages.
# WHATSAPP_TOKEN=...
# WHATSAPP_PHONE_NUMBER_ID=...
# WHATSAPP_API_VERSION=v21.0

# AI agents (02-intelligence/ai-agents.md). Unlike Stripe/WhatsApp there's no free test mode
# here — every call costs real tokens once set. Without it, queue-dispatch-agent's overflow
# recommendation falls back to a fixed message instead of a real judgment call; nothing else
# in this app calls Claude. Get a key from https://console.anthropic.com/settings/keys.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AGENT_MODEL=claude-sonnet-5
