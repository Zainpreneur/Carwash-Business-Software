# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database — local file for dev, or Turso cloud in production.
#   dev:    file:local.db   (resolved against packages/db, shared by API + drizzle-kit)
#   turso:  libsql://<db>-<org>.turso.io
LIBSQL_URL=file:local.db
LIBSQL_AUTH_TOKEN=

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-min-32
BETTER_AUTH_URL=http://localhost:3000

# Browser origins allowed to call the API
FRONTEND_URL=http://localhost:5173

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------------------------------------------------------
# Web (Vite)
# ---------------------------------------------------------------------------
# Leave empty in dev to use the Vite proxy at /api.
VITE_API_URL=
# Public URL of the API, used at build time in Docker/Coolify
PUBLIC_API_URL=http://localhost:3000

# Seed owner email (optional)
SEED_ADMIN_EMAIL=
